source /etc/sysbox/shell/nu/config/source/core/uenv.config.nu
source /etc/sysbox/shell/nu/config/source/core/sysbox.config.nu
source /etc/sysbox/shell/nu/config/source/core/prompt.config.nu

# More are available in /etc/sysbox/shell/nu/source/component
source /etc/sysbox/shell/nu/config/source/component/git.config.nu
source /etc/sysbox/shell/nu/config/source/component/npm.config.nu
source /etc/sysbox/shell/nu/config/source/component/python.config.nu
source /etc/sysbox/shell/nu/config/source/component/rust.config.nu
source /etc/sysbox/shell/nu/config/source/component/terminal.config.nu

source ./source/path.config.nu

